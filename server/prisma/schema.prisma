generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String                @id @default(uuid())
  name               String
  slug               String                @unique
  logo               String?
  address            String?
  contactEmail       String?
  contactPhone       String?
  contactName        String?
  status             String                @default("active")
  plan               String                @default("basic")
  licenseId          String?
  licenseExpiry      DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  admissionSessions  AdmissionSession[]
  announcements      Announcement[]
  auditLogs          AuditLog[]
  branches           Branch[]
  ceoPanels          CeoPanel[]
  complaints         Complaint[]
  departments        Department[]
  designations       Designation[]
  editDeleteRequests EditDeleteRequest[]
  escalations        Escalation[]
  expenseClaims      ExpenseClaim[]
  feeStructures      FeeStructure[]
  gstSettings        GSTSetting[]
  settings           HRSettings?
  holidays           Holiday[]
  internalMarks      InternalMark[]
  invoices           Invoice[]
  leads              Lead[]
  leaveAllocations   LeaveAllocation[]
  notifications      Notification[]
  payments           PaymentEntry[]
  payrollBatches     PayrollBatch[]
  programs           Program[]
  programAllocations ProgramAllocation[]
  programFees        ProgramFeeStructure[]
  referralLinks      ReferralLink[]
  salaryConfigs      SalaryConfig[]
  studyCenters       StudyCenter[]
  invites            StudyCenterInvite[]
  subDepartments     SubDepartment[]
  targets            Target[]
  universities       University[]
  authFees           UniversityAuthFee[]
  users              User[]
  vacancies          Vacancy[]
  walletTopUps       WalletTopUp[]
  licenses           License[]             @relation("LicenseToOrganization")
  EmployeeProfile    EmployeeProfile[]
  CredentialRequest  CredentialRequest[]
  IncentiveStructure IncentiveStructure[]
  Poll               Poll[]
  ProgramMaterial    ProgramMaterial[]
  ReregRule          ReregRule?
  SessionRequest     SessionRequest[]
  Task               Task[]
}

model User {
  id                      String                @id @default(uuid())
  userId                  String                @unique
  organizationId          String
  departmentId            String?
  additionalDepartmentIds String[]
  branchId                String?
  subDepartmentId         String?
  ceoPanelId              String?
  studyCenterId           String?
  email                   String                @unique
  password                String
  name                    String
  role                    String
  avatar                  String?
  phone                   String?
  designation             String?
  reportingTo             String?
  status                  String                @default("active")
  lastLogin               DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  designationId           String?
  managedBranch           Branch?               @relation("BranchManager")
  approvedSessions        AdmissionSession[]    @relation("SessionApprover")
  postedAnnouncements     Announcement[]        @relation("AnnouncementAuthor")
  attendances             Attendance[]
  auditLogs               AuditLog[]
  ceoPanel                CeoPanel?             @relation("CeoPanelUser")
  createdCeoPanels        CeoPanel[]            @relation("CeoPanelCreator")
  complaints              Complaint[]
  managedDepartments      Department[]          @relation("DeptManager")
  editRequests            EditDeleteRequest[]   @relation("EditDeleteRequester")
  responseRequests        EditDeleteRequest[]   @relation("EditDeleteResponder")
  raisedEscalations       Escalation[]          @relation("EscalationRaiser")
  resolvedEscalations     Escalation[]          @relation("EscalationResolver")
  approvedExpenses        ExpenseClaim[]        @relation("ExpenseApprover")
  claimedExpenses         ExpenseClaim[]        @relation("ExpenseEmployee")
  gstSettings             GSTSetting[]
  enteredMarks            InternalMark[]        @relation("MarkEntry")
  referredLeads           Lead[]                @relation("LeadReferrer")
  leaveAllocations        LeaveAllocation[]
  leaveRequests           LeaveRequest[]
  notifications           Notification[]
  receivedPayments        PaymentEntry[]
  payrollRecords          Payroll[]
  approvedBatches         PayrollBatch[]        @relation("BatchApprover")
  transferredBatches      PayrollBatch[]        @relation("BatchTransferrer")
  authoredAllocations     ProgramAllocation[]   @relation("AllocationAuthor")
  createdFees             ProgramFeeStructure[] @relation("FeeCreator")
  referralLinks           ReferralLink[]
  salaryConfig            SalaryConfig?
  invites                 StudyCenterInvite[]
  createdSubDepts         SubDepartment[]       @relation("SubDeptCreator")
  managedSubDepts         SubDepartment[]       @relation("SubDeptManager")
  targets                 Target[]
  assignedTasks           Task[]                @relation("AssignedTasks")
  createdTasks            Task[]                @relation("CreatedTasks")
  escalatedTasks          Task[]                @relation("EscalatedTasks")
  configuredFees          UniversityAuthFee[]
  branch                  Branch?               @relation(fields: [branchId], references: [id])
  department              Department?           @relation("UserDepartment", fields: [departmentId], references: [id])
  assignedDesignation     Designation?          @relation(fields: [designationId], references: [id])
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studyCenter             StudyCenter?          @relation(fields: [studyCenterId], references: [id])
  subDepartment           SubDepartment?        @relation(fields: [subDepartmentId], references: [id])
  employeeProfile         EmployeeProfile?
  verifiedTopUps          WalletTopUp[]         @relation("TopUpVerifier")
  CredentialRequest       CredentialRequest[]
  ReregRule               ReregRule[]
  SessionRequest          SessionRequest[]
  ProgramMaterial         ProgramMaterial[]
  Poll                    Poll[]
}

model Department {
  id                  String             @id @default(uuid())
  organizationId      String
  name                String
  type                String
  subType             String?
  parentDepartmentId  String?
  managerId           String?
  assistantManagerIds String[]
  features            String[]
  permissions         Json?
  status              String             @default("active")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  admissionSessions   AdmissionSession[]
  announcements       Announcement[]
  manager             User?              @relation("DeptManager", fields: [managerId], references: [id], onDelete: SetNull)
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment    Department?        @relation("SubDepartments", fields: [parentDepartmentId], references: [id])
  subDepartments      Department[]       @relation("SubDepartments")
  designations        Designation[]
  subDeptRelations    SubDepartment[]
  targets             Target[]
  users               User[]             @relation("UserDepartment")
  vacancies           Vacancy[]
  Task                Task[]
  salesBranch         Branch[]           @relation("BranchSalesDept")
  opsBranch           Branch[]           @relation("BranchOpsDept")
  additionalBranches  Branch[]           @relation("BranchAdditionalDepts")
}

model SubDepartment {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  parentDeptId   String
  managerId      String?
  features       String[]
  status         String        @default("active")
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  designations   Designation[]
  creator        User          @relation("SubDeptCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  manager        User?         @relation("SubDeptManager", fields: [managerId], references: [id], onDelete: SetNull)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDept     Department    @relation(fields: [parentDeptId], references: [id])
  users          User[]
  programs       Program[]     @relation("ProgramToSubDepartment")
  studyCenters   StudyCenter[] @relation("StudyCenterToSubDepartment")
  universities   University[]  @relation("SubDepartmentToUniversity")

  @@unique([organizationId, parentDeptId, name])
}

model Branch {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  status         String              @default("active")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invites        StudyCenterInvite[]
  users              User[]
  designations       Designation[]
  branchManagerId    String?        @unique
  branchManager      User?          @relation("BranchManager", fields: [branchManagerId], references: [id])
  salesDeptId        String?
  operationsDeptId   String?
  salesDept          Department?    @relation("BranchSalesDept", fields: [salesDeptId], references: [id])
  operationsDept     Department?    @relation("BranchOpsDept", fields: [operationsDeptId], references: [id])
  additionalDepts    Department[]   @relation("BranchAdditionalDepts")
}

model StudyCenter {
  id                   String              @id @default(uuid())
  organizationId       String
  name                 String
  code                 String              @unique
  address              String?
  city                 String?
  state                String?
  contactPerson        String?
  contactEmail         String?
  contactPhone         String?
  status               String              @default("pending")
  assignedUniversities String[]
  assignedPrograms     String[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  verifiedBy           String?
  verifiedAt           DateTime?
  opsRemarks           String?
  financeApprovedBy    String?
  financeApprovedAt    DateTime?
  paymentRemarks       String?
  paymentProof         Json?
  referredById         String?
  enrollments          Enrollment[]
  internalMarks        InternalMark[]
  invoices             Invoice[]
  programAllocations   ProgramAllocation[]
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wallet               StudyCenterWallet?
  targets              Target[]
  users                User[]
  walletTopUps         WalletTopUp[]
  subDepartments       SubDepartment[]     @relation("StudyCenterToSubDepartment")
  SessionRequest       SessionRequest[]
}

model University {
  id               String              @id @default(uuid())
  organizationId   String
  subDepartmentId  String?
  name             String
  code             String
  address          String?
  contact          String?
  status           String              @default("active")
  allowedBranchIds String[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  enrollments      Enrollment[]
  programs         Program[]
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authFees         UniversityAuthFee[]
  subDepartments   SubDepartment[]     @relation("SubDepartmentToUniversity")
}

model Program {
  id              String               @id @default(uuid())
  universityId    String
  organizationId  String
  subDepartmentId String?
  name            String
  code            String
  courseType      String               @default("Online Degree")
  duration        Int
  hasSemesters    Boolean              @default(false)
  semesters       Json?
  status          String               @default("active")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  enrollments     Enrollment[]
  universityFees  FeeStructure?
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  university      University           @relation(fields: [universityId], references: [id])
  allocations     ProgramAllocation[]
  programPricing  ProgramFeeStructure?
  subDepartments  SubDepartment[]      @relation("ProgramToSubDepartment")
}

model License {
  id             String         @id @default(uuid())
  name           String
  type           String
  features       String[]
  maxUsers       Int            @default(10)
  maxStorage     Int            @default(1024)
  durationMonths Int            @default(12)
  price          Float
  status         String         @default("active")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizations  Organization[] @relation("LicenseToOrganization")
}

model HRSettings {
  id                        String       @id @default(uuid())
  organizationId            String       @unique
  officeHours               Json?
  latePolicy                Json?
  location                  Json?
  locations                 Json?
  requireLocationForCheckIn Boolean      @default(true)
  biometric                 Json?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FeeStructure {
  id              String       @id @default(uuid())
  programId       String       @unique
  organizationId  String
  registrationFee Float        @default(0)
  tuitionFee      Float        @default(0)
  examFee         Float        @default(0)
  otherCharges    Json?
  gstPercentage   Float        @default(18)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program         Program      @relation(fields: [programId], references: [id])
}

model SalaryConfig {
  id                     String       @id @default(uuid())
  organizationId         String
  userId                 String       @unique
  basicSalary            Float        @default(0)
  allowances             Json?
  deductions             Json?
  lateDeductionPerMinute Float        @default(0)
  effectiveFrom          DateTime     @default(now())
  createdBy              String
  approvalStatus         String       @default("pending_approval")
  approvedBy             String?
  approvedAt             DateTime?
  rejectedRemarks        String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id               String       @id @default(uuid())
  title            String
  description      String
  status           String       @default("pending")
  priority         String       @default("medium")
  dueDate          DateTime?
  completedAt      DateTime?
  remarks          String?
  evidence         String[]
  escalationStatus String       @default("none")
  escalatedAt      DateTime?
  escalatedToId    String?
  gracePeriodEnd   DateTime?
  creatorId        String
  assigneeId       String
  orgId            String
  departmentId     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  assignee         User         @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator          User         @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
  escalatedTo      User?        @relation("EscalatedTasks", fields: [escalatedToId], references: [id], onDelete: SetNull)
  department       Department?  @relation(fields: [departmentId], references: [id])
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        String    @id @default(uuid())
  userId    String
  date      DateTime  @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    String
  orgId     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id        String   @id @default(uuid())
  userId    String
  type      String
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    String   @default("pending")
  orgId     String
  statusRemarks String?
  approvedBy    String?
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id                     String              @id @default(uuid())
  enrollmentNumber       String?             @unique
  studentId              String
  universityId           String
  programId              String
  studyCenterId          String?
  status                 String              @default("pending")
  orgId                  String
  deptReviewedBy         String?
  deptReviewedAt         DateTime?
  deptRemarks            String?
  financeReviewedBy      String?
  financeReviewedAt      DateTime?
  financeRemarks         String?
  admissionSessionId     String?
  enrolledBy             String?
  enrolledAt             DateTime?
  transferredToFinance   Boolean             @default(false)
  transferredToFinanceAt DateTime?
  financeApprovedBy      String?
  financeApprovedAt      DateTime?
  paymentDate            DateTime?
  paymentMethod          String?
  paymentReference       String?
  processedBy            String?
  processedAt            DateTime?
  remarks                String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  program                Program             @relation(fields: [programId], references: [id])
  student                Student             @relation(fields: [studentId], references: [id])
  center                 StudyCenter?        @relation(fields: [studyCenterId], references: [id])
  university             University          @relation(fields: [universityId], references: [id])
  payments               EnrollmentPayment[]
}

model Student {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  orgId         String
  status        String         @default("pending")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  enrollments   Enrollment[]
  internalMarks InternalMark[]
  invoices      Invoice[]
}

model EnrollmentPayment {
  id           String     @id @default(uuid())
  enrollmentId String
  amount       Float
  type         String
  status       String     @default("pending")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
}

model Payroll {
  id                     String    @id @default(uuid())
  userId                 String
  month                  Int
  year                   Int
  basicSalary            Float
  allowances             Float     @default(0)
  deductions             Float     @default(0)
  netSalary              Float     @default(0)
  status                 String    @default("draft")
  orgId                  String
  transferredToFinance   Boolean   @default(false)
  transferredToFinanceAt DateTime?
  financeApprovedBy      String?
  financeApprovedAt      DateTime?
  paymentDate            DateTime?
  paymentMethod          String?
  paymentReference       String?
  processedBy            String?
  processedAt            DateTime?
  remarks                String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model StudyCenterWallet {
  id        String      @id @default(uuid())
  centerId  String      @unique
  balance   Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  center    StudyCenter @relation(fields: [centerId], references: [id])
}

model ReferralLink {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  employeeName   String
  slug           String       @unique
  fullUrl        String
  status         String       @default("active")
  metrics        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdmissionSession {
  id              String       @id @default(uuid())
  organizationId  String
  subDepartmentId String
  name            String
  startDate       DateTime
  endDate         DateTime
  examDate        DateTime?
  status          String       @default("pending")
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  approver        User?        @relation("SessionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subDepartment   Department   @relation(fields: [subDepartmentId], references: [id])
}

model InternalMark {
  id             String       @id @default(uuid())
  organizationId String
  studentId      String
  subjectId      String
  subjectName    String?
  marks          Float
  maxMarks       Float
  examType       String
  enteredBy      String
  enteredAt      DateTime     @default(now())
  studyCenterId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  author         User         @relation("MarkEntry", fields: [enteredBy], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id])
  center         StudyCenter? @relation(fields: [studyCenterId], references: [id])
}

model Announcement {
  id             String       @id @default(uuid())
  organizationId String
  departmentId   String?
  title          String
  content        String
  type           String       @default("general")
  priority       String       @default("medium")
  postedBy       String
  postedAt       DateTime     @default(now())
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  department     Department?  @relation(fields: [departmentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User         @relation("AnnouncementAuthor", fields: [postedBy], references: [id], onDelete: Cascade)
}

model ProgramAllocation {
  id             String       @id @default(uuid())
  organizationId String
  studyCenterId  String
  programId      String
  allocatedBy    String
  allocatedAt    DateTime     @default(now())
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  author         User         @relation("AllocationAuthor", fields: [allocatedBy], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program        Program      @relation(fields: [programId], references: [id])
  center         StudyCenter  @relation(fields: [studyCenterId], references: [id])

  @@unique([organizationId, studyCenterId, programId])
}

model WalletTopUp {
  id              String       @id @default(uuid())
  studyCenterId   String
  organizationId  String
  amount          Float
  paymentMethod   String
  referenceNumber String?
  proofDocument   String?
  status          String       @default("pending")
  remarks         String?
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  center          StudyCenter  @relation(fields: [studyCenterId], references: [id])
  verifier        User?        @relation("TopUpVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
}

model ProgramFeeStructure {
  id             String       @id @default(uuid())
  programId      String       @unique
  organizationId String
  billingCycle   String
  baseFee        Float        @default(0)
  additionalFees Json?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  creator        User         @relation("FeeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program        Program      @relation(fields: [programId], references: [id])
}

model Invoice {
  id             String         @id @default(uuid())
  organizationId String
  centerId       String?
  studentId      String?
  amount         Float
  gstPercentage  Float?
  gstAmount      Float?
  total          Float
  status         String         @default("pending")
  paidAt         DateTime?
  period         String?
  type           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  center         StudyCenter?   @relation(fields: [centerId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student?       @relation(fields: [studentId], references: [id])
  payments       PaymentEntry[]
}

model PaymentEntry {
  id              String       @id @default(uuid())
  organizationId  String
  invoiceId       String
  amount          Float
  paymentMethod   String
  referenceNumber String?
  receivedBy      String
  receivedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  invoice         Invoice      @relation(fields: [invoiceId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author          User         @relation(fields: [receivedBy], references: [id], onDelete: Cascade)
}

model ExpenseClaim {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  category       String
  amount         Float
  description    String?
  receipts       Json?
  status         String       @default("pending")
  approvedBy     String?
  approvedAt     DateTime?
  remarks        String?
  submittedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approver       User?        @relation("ExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  employee       User         @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Target {
  id             String       @id @default(uuid())
  organizationId String
  departmentId   String?
  employeeId     String?
  centerId       String?
  type           String
  period         String
  target         Float
  achieved       Float        @default(0)
  incentive      Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  center         StudyCenter? @relation(fields: [centerId], references: [id])
  department     Department?  @relation(fields: [departmentId], references: [id])
  employee       User?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model GSTSetting {
  id             String       @id @default(uuid())
  organizationId String
  feeType        String
  gstPercentage  Float
  hsnCode        String?
  sacCode        String?
  applicableFrom DateTime
  applicableTo   DateTime?
  allowOverride  Boolean      @default(false)
  status         String       @default("active")
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  creator        User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  timestamp      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UniversityAuthFee {
  id             String       @id @default(uuid())
  organizationId String
  universityId   String
  amount         Float
  currency       String       @default("INR")
  configuredBy   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  author         User         @relation(fields: [configuredBy], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  university     University   @relation(fields: [universityId], references: [id])
}

model PayrollBatch {
  id              String       @id @default(uuid())
  organizationId  String
  batchNumber     String       @unique
  month           String
  payrollIds      String[]
  totalAmount     Float
  employeeCount   Int
  status          String       @default("pending_finance_approval")
  transferredBy   String
  transferredAt   DateTime     @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  completedAt     DateTime?
  remarks         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  approver        User?        @relation("BatchApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author          User         @relation("BatchTransferrer", fields: [transferredBy], references: [id], onDelete: Cascade)
}

model Vacancy {
  id             String       @id @default(uuid())
  organizationId String
  departmentId   String
  designation    String
  count          Int
  filled         Int          @default(0)
  status         String       @default("open")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  department     Department   @relation(fields: [departmentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Complaint {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  subject        String
  description    String
  category       String
  status         String       @default("open")
  priority       String       @default("medium")
  submittedAt    DateTime     @default(now())
  resolvedAt     DateTime?
  resolution     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  date           DateTime
  type           String       @default("company")
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  title          String
  message        String
  type           String?
  data           Json?
  priority       String       @default("medium")
  read           Boolean      @default(false)
  link           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CeoPanel {
  id             String       @id @default(uuid())
  organizationId String
  assignedUserId String       @unique
  name           String
  dataScope      String[]     @default(["all"])
  status         String       @default("active")
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignedUser   User         @relation("CeoPanelUser", fields: [assignedUserId], references: [id], onDelete: Cascade)
  creator        User         @relation("CeoPanelCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Designation {
  id                  String         @id @default(uuid())
  organizationId      String
  departmentId        String?
  subDepartmentId     String?
  branchId            String?
  title               String
  level               Int            @default(1)
  parentDesignationId String?
  maxHeadcount        Int            @default(1)
  status              String         @default("active")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  department          Department?    @relation(fields: [departmentId], references: [id])
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDesignation   Designation?   @relation("DesignationHierarchy", fields: [parentDesignationId], references: [id])
  childDesignations   Designation[]  @relation("DesignationHierarchy")
  subDepartment       SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  users               User[]
  branch              Branch?        @relation(fields: [branchId], references: [id])
}

model StudyCenterInvite {
  id             String       @id @default(uuid())
  organizationId String
  token          String       @unique
  universityIds  String[]
  programIds     String[]
  referredBy     String
  branchId       String?
  status         String       @default("pending")
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrer       User         @relation(fields: [referredBy], references: [id])
}

model Escalation {
  id             String       @id @default(uuid())
  organizationId String
  type           String
  entityId       String
  entityType     String
  raisedById     String
  raisedAt       DateTime     @default(now())
  currentLevel   Int          @default(1)
  maxLevel       Int          @default(3)
  status         String       @default("active")
  description    String
  impact         String       @default("medium")
  chain          Json?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
